# Read by docker compose, which passes these into the containers. The address
# the server binds and the proxy it trusts aren't here: compose owns those, so a
# stale value can't break container networking.

# Log verbosity floor: debug | info | warn | error
LOG_LEVEL=info

# Connection caps enforced at the websocket upgrade.
MAX_TOTAL_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=24

# Set a secret token to enable admin mode.
# Store the same value in localStorage under "koholint:admin" in the browser.
# The /admin panel (feedback viewer) takes it from the "koholint_admin" cookie
# instead, set by hand: document.cookie = "koholint_admin=<token>; path=/"
ADMIN_TOKEN=

# Site address Caddy serves in the prod stack. A real hostname makes it
# provision a Let's Encrypt certificate; left unset it falls back to localhost
# with Caddy's internal CA.
DOMAIN=
