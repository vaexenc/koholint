{
	"name": "koholint",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n \"client,server\" -c \"cyan,yellow\" \"npm run dev:client\" \"npm run dev:server\"",
		"dev:client": "vite",
		"dev:server": "nodemon --watch server --watch src --watch public/maps --ext ts,tsx,json --ignore server/data --exec \"tsx --env-file-if-exists=.env server/index.ts\"",
		"start": "tsx --env-file-if-exists=.env --tsconfig tsconfig.server.json server/index.ts",
		"prod": "npm run build && concurrently -n \"client,server\" -c \"cyan,yellow\" \"npm run preview\" \"npm run start\"",
		"db:generate": "drizzle-kit generate",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"preview": "vite preview",
		"format": "prettier --write .",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@hono/node-server": "^2.0.4",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-query": "^5.100.14",
		"@tanstack/react-router": "^1.170.7",
		"@workadventure/tiled-map-type-guard": "^2.1.2",
		"better-sqlite3": "^12.11.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.23",
		"lucide-react": "^1.16.0",
		"obscenity": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.8.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"unique-names-generator": "^4.7.1",
		"ws": "^8.21.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.4.6",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/tanstack-react": "^10.4.6",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^10.0.3",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"eslint-plugin-storybook": "^10.4.6",
		"globals": "^17.6.0",
		"nodemon": "^3.1.14",
		"prettier": "^2.8.8",
		"prettier-plugin-organize-imports": "^4.3.0",
		"storybook": "^10.4.6",
		"tsx": "^4.22.3",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.12"
	}
}
